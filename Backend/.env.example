# Copy this file to ".env" (same folder) and fill in real values to make
# price-drop alerts actually send email. Without a .env file, alerts still
# work (matching is detected and logged) but no email is sent.
#
# For Gmail: turn on 2-Step Verification, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS
# (not your normal Gmail password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
ALERT_FROM_EMAIL=your-email@gmail.com
